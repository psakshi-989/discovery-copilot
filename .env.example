# Copy to .env and fill in. Never commit .env.
# Which provider to run: groq | gemini | openrouter
PROVIDER=groq

# Groq (free tier): key from console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini (free tier): key from Google AI Studio.
# Set GEMINI_MODEL to a model that shows a free tier in AI Studio's rate-limit page.
GEMINI_API_KEY=
GEMINI_MODEL=

# OpenRouter (free ":free" models are limited to a small number of requests per day)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# --- Website settings (needed when deploying) ---
# Postgres connection string from Neon or Supabase (free). Required on Vercel.
# Leave empty on your own computer: runs are saved to the .data folder instead.
DATABASE_URL=
# Any long random text. Used to hash visitor addresses so they are never stored.
IP_HASH_SALT=change-me
# Daily limits that protect the free AI quota
RUNS_PER_IP_PER_DAY=3
DAILY_RUN_CAP=25
# Pause between stages in milliseconds (keeps Groq's per-minute limit happy)
STAGE_PAUSE_MS=15000
